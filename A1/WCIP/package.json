{
  "name": "wcip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images:generate": "node scripts/generate-images.mjs",
    "predev": "npm run images:generate",
    "dev": "vite",
    "prebuild": "npm run images:generate",
    "build": "vite build",
    "preview": "vite preview",
    "hosting:serve": "npm run build && firebase emulators:start --only hosting --project fit5032-e0aef",
    "deploy:hosting": "firebase deploy --only hosting:wcip --project fit5032-e0aef",
    "functions:check": "npm --prefix functions run check",
    "functions:serve": "npm run functions:check && firebase emulators:start --config firebase.emulators.json --only auth,firestore,functions --project demo-wcip",
    "deploy:functions": "firebase deploy --only functions:wcip --project fit5032-e0aef",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --config firebase.emulators.json --only firestore --project demo-wcip \"node --test tests/firestore.rules.mjs\"",
    "dev:emulators": "npm run functions:check && firebase emulators:start --config firebase.emulators.json --only auth,firestore,functions --project demo-wcip",
    "seed:emulators": "node scripts/seed-dashboard-emulator.mjs && node scripts/backfill-analytics.mjs --emulator",
    "api:dev": "wrangler dev --ip 127.0.0.1",
    "api:check": "wrangler deploy --dry-run",
    "deploy:api": "wrangler deploy",
    "test:functions": "npm run functions:check && firebase emulators:exec --config firebase.emulators.json --only auth,firestore,functions --project demo-wcip \"node --test --test-concurrency=1 tests/functions.integration.mjs tests/seasonalEmail.integration.mjs\""
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootswatch": "^5.3.8",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "vue": "rc",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.9.2",
    "firebase-tools": "^15.30.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.5",
    "sharp": "^0.35.5",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}
