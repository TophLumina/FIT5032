{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "wcip",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm run build"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "regex": ".*",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://wcip-plant-api.wcip.workers.dev https://australia-southeast1-fit5032-e0aef.cloudfunctions.net; frame-src https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^[/\\\\]assets[/\\\\].*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "regex": "^[/\\\\]images[/\\\\]generated[/\\\\].*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "wcip",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log", ".env*", ".secret.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run check"]
    }
  ],
  "emulators": {
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
